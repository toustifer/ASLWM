  <path d="M100,340 Q150,200 200,120 Q250,90 300,70 Q400,55 500,50 Q650,45 820,40" fill="none" stroke="#e74c3c" stroke-width="2" stroke-dasharray="6,3"/>
  <text x="830" y="42" font-family="Arial, sans-serif" font-size="13" fill="#e74c3c">LeWM (0.90)</text>
